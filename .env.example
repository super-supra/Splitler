# Password you type on the home page to create groups
ADMIN_PASSWORD=
# Long random string used to sign the admin cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Added automatically when you connect Upstash Redis from the Vercel Marketplace.
# Leave unset locally to use an in-memory store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
